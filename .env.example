# Copy to .env (or export) to point the API at your database.
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
# "model" (default, Loop 2) or "rules" (Loop 1 fallback)
AEGIS_DETECTOR=model
# "1" (default) shows the demo controls in the web app; "0" wherever real data lives
AEGIS_DEMO=1
